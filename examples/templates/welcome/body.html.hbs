{{#> base_html}}
<h2 class="mc-title" style="margin: 0 0 16px 0; font-size: 20px; font-weight: 600; color: #333333; line-height: 1.4;">Welcome, {{name}}!</h2>

<p class="mc-text" style="margin: 0 0 16px 0; font-size: 15px; color: #333333; line-height: 1.6;">Thanks for signing up for <strong>{{app_name}}</strong>. We're glad to have you.</p>

<p class="mc-text" style="margin: 0 0 24px 0; font-size: 15px; color: #333333; line-height: 1.6;">Get started by completing your profile:</p>

<!-- CTA button -->
<table role="presentation" cellpadding="0" cellspacing="0" border="0">
  <tr>
    <td align="center" style="border-radius: 6px; background-color: #2563EB;">
      <a href="{{profile_url}}" style="display: inline-block; padding: 12px 24px; font-size: 15px; font-weight: 600; color: #FFFFFF; text-decoration: none; border-radius: 6px;">Complete your profile</a>
    </td>
  </tr>
</table>

<p class="mc-text" style="margin: 24px 0 0 0; font-size: 15px; color: #333333; line-height: 1.6;">Cheers,<br>The {{app_name}} team</p>
{{/base_html}}